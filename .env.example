# ------------------------------------------------------------------
# GET HIRED KIT — environment configuration
# Copy to .env and adjust. NEVER commit a real .env with secrets.
# ------------------------------------------------------------------

# Port the server listens on (Render sets this automatically).
PORT=3000

# --- AI (Google Gemini, FREE tier via OpenAI-compatible endpoint) ---
# Get a free key at https://aistudio.google.com/apikey (no card needed).
# Without a key the app runs in "training dummy" offline mode (built-in
# question bank + generic roasts) — the UI stays fully clickable.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.0-flash

# --- Pro license ---
# Random secret used to sign Pro cookies. Set a long random value in
# production; if unset, one is generated per boot (Pro unlocks reset on restart).
PRO_SECRET=
# Optional: Gumroad access token to verify keys against real sales.
# Without it, verification is checksum-only (honest v1 tradeoff, see README).
GUMROAD_ACCESS_TOKEN=
# Public URL of your $29 Gumroad product (shown on the "Go Pro" button).
GUMROAD_PRODUCT_URL=

# Free tier: AI generations per client per day.
FREE_DAILY_QUOTA=3

# Comma-separated allowed frontend origins, e.g.
# FRONTEND_URL=https://get-hired-kit.onrender.com
# Leave empty to allow all origins (fine for local dev).
FRONTEND_URL=

# Per-IP rate limits.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Trust proxy hops for correct client IPs behind Render/Heroku-style hosts.
TRUST_PROXY=1

# Set to "production" on Render (enables Secure cookies).
NODE_ENV=development
